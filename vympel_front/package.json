{
  "name": "vympel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs && node scripts/check-glob-security.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sharp-security": "node ../scripts/check-sharp-security.mjs",
    "test:production-status": "node scripts/test-production-status.mjs",
    "test:security": "node --test --test-isolation=none scripts/test-security-headers.mjs",
    "test:budgets": "node ../scripts/check-performance-budgets.mjs",
    "test:budgets:ci": "node ../scripts/check-performance-budgets.mjs --require-build",
    "test:glob-security": "node scripts/check-glob-security.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@reduxjs/toolkit": "^2.13.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "5.0.12"
    },
    "@parcel/watcher": {
      "picomatch": "4.0.5"
    },
    "js-yaml": "4.3.2",
    "svgo": "3.3.5",
    "next": {
      "postcss": "8.5.26",
      "sharp": "^0.35.5"
    },
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0"
  }
}
