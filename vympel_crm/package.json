{
  "name": "vympel-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "postinstall": "node scripts/patch-minimatch-brace-expansion.mjs && node scripts/check-glob-security.mjs",
    "start": "next start -p 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:sharp-security": "node ../scripts/check-sharp-security.mjs",
    "test:security": "node --test --test-isolation=none scripts/test-security-headers.mjs",
    "test:budgets": "node ../scripts/check-performance-budgets.mjs",
    "test:budgets:ci": "node ../scripts/check-performance-budgets.mjs --require-build",
    "test:production-headers": "node scripts/test-production-headers.mjs",
    "test:glob-security": "node scripts/check-glob-security.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@testing-library/react": "^16.3.0",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "typescript": "^7",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "5.0.12"
    },
    "js-yaml": "4.3.2",
    "next": {
      "postcss": "8.5.26",
      "sharp": "^0.35.5"
    },
    "braces": "npm:@dieub/braces-depth-guard@3.0.3-pn.0"
  }
}
