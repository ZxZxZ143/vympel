# ----------------------------------------------------------------------
# VYMPEL public storefront — https://vympel.kz (production, indexable)
# Host Nginx site: /etc/nginx/sites-available/vympel-domain-main
# www.vympel.kz and the retired preview.vympel.kz permanently redirect here.
# No Basic Auth and no X-Robots-Tag: indexing policy is owned by the
# storefront image (SITE_INDEXING_ENABLED=true, robots.txt, sitemap.xml).
# ----------------------------------------------------------------------

server {
    listen 80;
    listen [::]:80;
    server_name vympel.kz www.vympel.kz preview.vympel.kz;

    server_tokens off;

    return 301 https://vympel.kz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.vympel.kz;

    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/vympel.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vympel.kz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://vympel.kz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name preview.vympel.kz;

    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/preview.vympel.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/preview.vympel.kz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://vympel.kz$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vympel.kz;

    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/vympel.kz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vympel.kz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
