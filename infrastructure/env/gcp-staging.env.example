# Copy to /etc/vympel/gcp-staging.env, set mode 0600, and replace every
# REPLACE_ME value. Keep the real file and every secret outside the repository.
REGISTRY=ghcr.io/zxzxz143
# Pinned to the exact SHA from the digest-complete v1.0.0-rc.8 publication manifest.
# The RC tag remains immutable, but the full SHA is the normal deployment selector.
RELEASE_TAG=aadfabfd23a4196bc385ae41a0f3b8719172ffbc
COMPOSE_PROJECT_NAME=vympel-gcp-staging

# Host Nginx runtime routing. These names are not compiled into an existing
# frontend image and must also match that image's published build contract.
STOREFRONT_DOMAIN=shop.34.18.200.58.sslip.io
CRM_DOMAIN=crm.34.18.200.58.sslip.io
API_DOMAIN=api.34.18.200.58.sslip.io

# Build-time public frontend contract. These browser-visible, non-secret values
# are compiled into the storefront/CRM images. Runtime values must remain equal
# to the selected published manifest; changing them does not rewrite a bundle.
NEXT_PUBLIC_BASE_API_PUBLIC=https://api.34.18.200.58.sslip.io/api/public
NEXT_PUBLIC_CRM_API_BASE=https://api.34.18.200.58.sslip.io/api/crm
NEXT_PUBLIC_MEDIA_ORIGINS=https://api.34.18.200.58.sslip.io
NEXT_PUBLIC_SITE_URL=https://shop.34.18.200.58.sslip.io
NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_APP_RELEASE=aadfabfd23a4196bc385ae41a0f3b8719172ffbc
NEXT_PUBLIC_TELEMETRY_ENABLED=false
# The sslip.io staging values are deployable public origins, not placeholders.
PUBLIC_BUILD_PLACEHOLDERS_ACKNOWLEDGED=false

# Runtime-only internal service contract. Container-to-container addresses use
# Compose service DNS names; no infrastructure service points at localhost.
VYMPEL_DB_NAME=vympel
VYMPEL_DB_URL=jdbc:postgresql://postgres:5432/vympel
VYMPEL_DB_USERNAME=vympel
VYMPEL_DB_PASSWORD=REPLACE_ME_RANDOM_DATABASE_PASSWORD
# Required only if check-liquibase-history.sh reports the unrecovered legacy row.
VYMPEL_LIQUIBASE_HISTORY_APPROVAL_FILE=

VYMPEL_REDIS_PASSWORD=REPLACE_ME_RANDOM_REDIS_PASSWORD
VYMPEL_REDIS_URL=redis://:REPLACE_ME_RANDOM_REDIS_PASSWORD@redis:6379

VYMPEL_S3_BUCKET=vympel-staging
VYMPEL_S3_REGION=us-east-1
VYMPEL_S3_PUBLIC_ENDPOINT=https://api.34.18.200.58.sslip.io/media
VYMPEL_S3_ACCESS_KEY=REPLACE_ME_RANDOM_MINIO_ACCESS_KEY
VYMPEL_S3_SECRET_KEY=REPLACE_ME_RANDOM_MINIO_SECRET_KEY

VYMPEL_JWT_SECRET=REPLACE_ME_AT_LEAST_48_RANDOM_CHARACTERS_FOR_JWT_SIGNING
VYMPEL_JWT_ACCESS_TTL_MIN=15
VYMPEL_JWT_REFRESH_TTL_DAYS=14
VYMPEL_RATE_LIMIT_HMAC_SECRET=REPLACE_ME_DIFFERENT_48_RANDOM_CHARACTERS_FOR_LIMITER_HMAC
VYMPEL_TRUSTED_PROXY_CIDRS=172.16.0.0/12
VYMPEL_CORS_ALLOWED_ORIGINS=https://shop.34.18.200.58.sslip.io,https://crm.34.18.200.58.sslip.io
VYMPEL_CRM_REFRESH_COOKIE_SAME_SITE=Lax

# Runtime-only server-to-server CMS revalidation. The secret is intentionally
# not prefixed NEXT_PUBLIC_* and is passed only to backend/storefront servers.
VYMPEL_CMS_PUBLIC_REVALIDATE_ENABLED=true
VYMPEL_CMS_REVALIDATE_REQUIRED=true
VYMPEL_CMS_REVALIDATE_SECRET=REPLACE_ME_AT_LEAST_48_RANDOM_CHARACTERS_FOR_CMS_HMAC
VYMPEL_CMS_MEDIA_CLEANUP_ENABLED=false
VYMPEL_ANALYTICS_CLEANUP_ENABLED=true
VYMPEL_ANALYTICS_CLEANUP_DRY_RUN=true

# Disabled by default. Enable only for one controlled initial bootstrap, then
# disable and clear these values immediately after the ADMIN is created.
VYMPEL_BOOTSTRAP_ADMIN_ENABLED=false
VYMPEL_BOOTSTRAP_ADMIN_EMAIL=
VYMPEL_BOOTSTRAP_ADMIN_PASSWORD=
VYMPEL_BOOTSTRAP_ADMIN_NAME=

# With backend=2048M this caps heap near 1229 MiB, leaving about 819 MiB for
# metaspace, direct buffers, threads, native libraries, and JVM overhead.
JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=20.0 -XX:MaxRAMPercentage=60.0 -XX:+ExitOnOutOfMemoryError
