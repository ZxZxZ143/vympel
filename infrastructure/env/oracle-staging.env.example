# Copy this template to /etc/vympel/staging.env, set mode 0600, replace every
# REPLACE_ME value, and keep the real file outside the repository.
REGISTRY=ghcr.io/zxzxz143
RELEASE_TAG=REPLACE_ME_RELEASE_TAG_OR_EXACT_SHA
COMPOSE_PROJECT_NAME=vympel-oracle-staging

# Final DNS is intentionally undecided. These values must exactly match the
# public build configuration recorded for the selected immutable image release.
STOREFRONT_DOMAIN=shop.oracle-staging.example.invalid
CRM_DOMAIN=crm.oracle-staging.example.invalid
API_DOMAIN=api.oracle-staging.example.invalid
TLS_CERT_DIR=/etc/letsencrypt/live/crm.oracle-staging.example.invalid
CRM_HTPASSWD_PATH=/etc/nginx/auth/vympel-crm.htpasswd
NEXT_PUBLIC_BASE_API_PUBLIC=https://api.oracle-staging.example.invalid/api/public
NEXT_PUBLIC_CRM_API_BASE=https://crm.oracle-staging.example.invalid/api/crm
NEXT_PUBLIC_MEDIA_ORIGINS=https://api.oracle-staging.example.invalid
NEXT_PUBLIC_SITE_URL=https://shop.oracle-staging.example.invalid
NEXT_PUBLIC_APP_ENV=staging
# This is true only because this committed template deliberately uses reserved
# .invalid names. Set false in the real env after choosing DNS and an image
# release built with those exact public values.
PUBLIC_BUILD_PLACEHOLDERS_ACKNOWLEDGED=true

VYMPEL_DB_NAME=vympel
VYMPEL_DB_URL=jdbc:postgresql://postgres:5432/vympel
VYMPEL_DB_USERNAME=vympel
VYMPEL_DB_PASSWORD=REPLACE_ME_RANDOM_DATABASE_PASSWORD
# Required only if check-liquibase-history.sh reports the unrecovered legacy row.
VYMPEL_LIQUIBASE_HISTORY_APPROVAL_FILE=

VYMPEL_REDIS_PASSWORD=REPLACE_ME_RANDOM_REDIS_PASSWORD
VYMPEL_REDIS_URL=redis://:REPLACE_ME_RANDOM_REDIS_PASSWORD@redis:6379

VYMPEL_S3_BUCKET=vympel-staging
VYMPEL_S3_REGION=us-east-1
VYMPEL_S3_PUBLIC_ENDPOINT=https://api.oracle-staging.example.invalid/media
VYMPEL_S3_ACCESS_KEY=REPLACE_ME_RANDOM_MINIO_ACCESS_KEY
VYMPEL_S3_SECRET_KEY=REPLACE_ME_RANDOM_MINIO_SECRET_KEY

VYMPEL_JWT_SECRET=REPLACE_ME_AT_LEAST_48_RANDOM_CHARACTERS_FOR_JWT_SIGNING
VYMPEL_JWT_ACCESS_TTL_MIN=15
VYMPEL_JWT_REFRESH_TTL_DAYS=14
VYMPEL_RATE_LIMIT_HMAC_SECRET=REPLACE_ME_DIFFERENT_48_RANDOM_CHARACTERS_FOR_LIMITER_HMAC
VYMPEL_TRUSTED_PROXY_CIDRS=172.16.0.0/12
VYMPEL_CORS_ALLOWED_ORIGINS=https://shop.oracle-staging.example.invalid,https://crm.oracle-staging.example.invalid
VYMPEL_CRM_TRUSTED_ORIGINS=https://crm.oracle-staging.example.invalid
VYMPEL_CRM_REFRESH_COOKIE_SAME_SITE=Lax

VYMPEL_CMS_PUBLIC_REVALIDATE_ENABLED=true
VYMPEL_CMS_REVALIDATE_REQUIRED=true
VYMPEL_CMS_REVALIDATE_SECRET=REPLACE_ME_AT_LEAST_48_RANDOM_CHARACTERS_FOR_CMS_HMAC
VYMPEL_CMS_MEDIA_CLEANUP_ENABLED=false
VYMPEL_ANALYTICS_CLEANUP_ENABLED=true
VYMPEL_ANALYTICS_CLEANUP_DRY_RUN=true
VYMPEL_CRM_ACTIVITY_RETENTION_DAYS=365
VYMPEL_CRM_ACTIVITY_CLEANUP_ENABLED=true
VYMPEL_CRM_ACTIVITY_CLEANUP_DRY_RUN=true
VYMPEL_CRM_ACTIVITY_CLEANUP_CRON=0 15 4 * * *
VYMPEL_CRM_ACTIVITY_CLEANUP_BATCH_SIZE=1000
VYMPEL_CRM_ACTIVITY_CLEANUP_MAX_BATCHES=20
VYMPEL_STORAGE_DELETION_ENABLED=true

# Disabled by default. Enable only for the first controlled bootstrap, then
# disable and clear these values immediately after the account is created.
VYMPEL_BOOTSTRAP_ADMIN_ENABLED=false
VYMPEL_BOOTSTRAP_ADMIN_EMAIL=
VYMPEL_BOOTSTRAP_ADMIN_PASSWORD=
VYMPEL_BOOTSTRAP_ADMIN_NAME=

JAVA_TOOL_OPTIONS=-XX:InitialRAMPercentage=25.0 -XX:MaxRAMPercentage=70.0 -XX:+ExitOnOutOfMemoryError

# Accountable backup/isolated-restore evidence required before deploy.sh pulls
# images or starts migrations. Keep the evidence file outside Git.
BACKUP_EVIDENCE_PATH=/etc/vympel/evidence/REPLACE_ME-backup-restore.env
BACKUP_EVIDENCE_SHA256=REPLACE_ME_LOWERCASE_SHA256_OF_EVIDENCE_FILE
RESTORE_REHEARSAL_ID=REPLACE_ME_RESTORE_REHEARSAL_ID
